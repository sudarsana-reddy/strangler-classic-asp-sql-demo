{
  "ReverseProxy": {
    "Routes": {
      "modern-login": {
        "ClusterId": "modern-login",
        "Order": 0,
        "Match": {
          "Path": "/session-login.asp"
        }
      },
      "modern-root": {
        "ClusterId": "modern-login",
        "Order": 0,
        "Match": {
          "Path": "/"
        }
      },
      "modern-logout": {
        "ClusterId": "modern-login",
        "Order": 0,
        "Match": {
          "Path": "/logout"
        }
      },
      "modern-logout-transfer": {
        "ClusterId": "modern-login",
        "Order": 0,
        "Match": {
          "Path": "/logout/transfer"
        }
      },
      "modern-session-transfer": {
        "ClusterId": "modern-login",
        "Order": 0,
        "Match": {
          "Path": "/session-transfer"
        }
      },
      "modern-login-assets": {
        "ClusterId": "modern-login",
        "Order": 0,
        "Match": {
          "Path": "/loginapp/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/loginapp"
          }
        ]
      },
      "legacy-session-bridge": {
        "ClusterId": "legacy",
        "Order": 0,
        "Match": {
          "Path": "/_bridge/session.asp"
        }
      },
      "legacy-logout-bridge": {
        "ClusterId": "legacy",
        "Order": 0,
        "Match": {
          "Path": "/_bridge/logout.asp"
        }
      },
      "legacy-fallback": {
        "ClusterId": "legacy",
        "Order": 100,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "modern-login": {
        "Destinations": {
          "login-app": {
            "Address": "http://127.0.0.1:8202/"
          }
        }
      },
      "legacy": {
        "Destinations": {
          "classic-asp": {
            "Address": "http://127.0.0.1:8200/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
